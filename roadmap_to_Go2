import random

class GridWorld:
    def __init__(self, size=5):
        self.size = size
        self.agent_pos = [0, 0]

    def is_wall(self, pos):
        x, y = pos
        return x < 0 or y < 0 or x >= self.size or y >= self.size

    def move(self, direction):
        dx, dy = {'up': (0, -1), 'down': (0, 1),
                  'left': (-1, 0), 'right': (1, 0)}[direction]
        new_pos = [self.agent_pos[0] + dx, self.agent_pos[1] + dy]
        if not self.is_wall(new_pos):
            self.agent_pos = new_pos

class ReflexAgent:
    def decide(self, env):
        # Always move right if possible, else move down
        x, y = env.agent_pos
        if not env.is_wall([x+1, y]):
            return 'right'
        elif not env.is_wall([x, y+1]):
            return 'down'
        else:
            return random.choice(['up', 'left'])

# Usage Example
if __name__ == "__main__":
    env = GridWorld()
    agent = ReflexAgent()
    for _ in range(10):
        action = agent.decide(env)
        env.move(action)
        print(f"Agent moved {action} to {env.agent_pos}")
